filters:
  and:
    - 유형 == "매물"
formulas:
  지역: '구 + " " + 동'
  평당보증금: "(보증금 / 면적_평).round(0)"
  역세권: 'if(도보분 > 0, 가까운역 + " " + 도보분 + "분", "미확인")'
properties:
  note.구:
    displayName: 구
  note.동:
    displayName: 동
  note.단지:
    displayName: 단지
  note.건물형태:
    displayName: 형태
  note.보증금:
    displayName: 보증금(만)
  note.가까운역:
    displayName: 역
  note.도보분:
    displayName: 도보(분)
  note.면적_평:
    displayName: 평
  note.관심도:
    displayName: ★
  note.상태:
    displayName: 상태
  note.융자:
    displayName: 융자
  note.확정일자:
    displayName: 확정일자
  note.입주가능일:
    displayName: 입주가능일
  formula.지역:
    displayName: 지역
  formula.평당보증금:
    displayName: 평당보증금(만)
  formula.역세권:
    displayName: 역세권
views:
  - type: table
    name: 핵심 4축
    order:
      - formula.지역
      - note.건물형태
      - note.보증금
      - formula.역세권
      - note.관심도
      - note.상태
    sort:
      - property: note.보증금
        direction: ASC
  - type: table
    name: 지역별
    order:
      - note.구
      - note.동
      - note.단지
      - note.건물형태
      - note.보증금
      - note.도보분
      - note.상태
    sort:
      - property: note.구
        direction: ASC
      - property: note.동
        direction: ASC
      - property: note.보증금
        direction: ASC
  - type: table
    name: 역과 가까운 순
    filters:
      and:
        - 도보분 > 0
    order:
      - note.가까운역
      - note.도보분
      - formula.지역
      - note.건물형태
      - note.보증금
    sort:
      - property: note.도보분
        direction: ASC
  - type: table
    name: 전체 매물
    order:
      - note.구
      - note.동
      - note.단지
      - note.건물형태
      - note.보증금
      - note.면적_평
      - formula.역세권
      - note.관심도
      - note.상태
    sort:
      - property: note.보증금
        direction: ASC
  - type: table
    name: 관심 매물
    filters:
      and:
        - 관심도 >= 3
        - 상태 != "제외"
    order:
      - formula.지역
      - note.보증금
      - note.면적_평
      - note.관심도
      - note.상태
    sort:
      - property: note.관심도
        direction: DESC
      - property: note.보증금
        direction: ASC
  - type: table
    name: 예산 내 (3억 이하)
    filters:
      and:
        - 보증금 <= 30000
        - 상태 != "제외"
    order:
      - formula.지역
      - note.건물형태
      - note.보증금
      - note.융자
      - note.확정일자
    sort:
      - property: note.보증금
        direction: ASC
  - type: table
    name: 융자 주의
    filters:
      and:
        - 융자 == true
    order:
      - formula.지역
      - note.보증금
      - note.확정일자
    sort:
      - property: note.보증금
        direction: ASC
  - type: cards
    name: 카드 보기
    order:
      - formula.지역
      - note.보증금
      - note.면적_평
      - note.상태
    sort:
      - property: note.관심도
        direction: DESC
